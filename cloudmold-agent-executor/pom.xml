<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.iocoder.cloud</groupId>
        <artifactId>yudao</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>cloudmold-agent-executor</artifactId>
    <name>${project.artifactId}</name>
    <description>Allowlisted CloudMold Skill executor over governed Dubbo contracts</description>

    <dependencies>
        <dependency>
            <groupId>cn.iocoder.cloud</groupId>
            <artifactId>cloudmold-rpc</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-agent-control-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-integration-yudao-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-skill-task-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-aftersales-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-ai-operations-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-catalog-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-commerce-behavior-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-customer-service-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-crossborder-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-engagement-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-fulfillment-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-gamification-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-identity-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-inventory-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-listing-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-merchant-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-metadata-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-dreamplant-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-operations-intelligence-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-order-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-payment-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-partner-marketing-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-promotion-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-procurement-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-supplier-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-finance-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-quality-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-risk-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-token-platform-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-supply-planning-api</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>cn.iocoder.cloud</groupId><artifactId>cloudmold-module-warehouse-api</artifactId><version>${revision}</version></dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.cloud</groupId>
            <artifactId>yudao-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <!-- Keep the primary artifact as a reusable thin jar for the
                                 long-lived MCP adapter. The executable CLI remains attached. -->
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
