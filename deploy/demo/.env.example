COMPOSE_PROJECT_NAME=cloudmold-demo
DEMO_BIND_ADDRESS=127.0.0.1
DEMO_HTTP_PORT=8080
BACKEND_PORT=48080

# Use a cloned, backed-up Demo database whose complete Yudao schema and
# CloudMold V01-V12 migrations have already been validated. Do not point this
# release surface at production or the only copy of any data.
CLOUDMOLD_DB_URL=jdbc:mysql://replace-with-private-db-host:3306/ruoyi-vue-pro?useSSL=true&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true
CLOUDMOLD_DB_USERNAME=replace-with-demo-db-user
CLOUDMOLD_DB_PASSWORD=replace-with-a-random-demo-secret
REDIS_PASSWORD=replace-with-a-different-random-demo-secret

# CI or the release workstation must build these commit-SHA tags first.
CLOUDMOLD_BACKEND_IMAGE=cloudmold/backend:replace-with-commit-sha
CLOUDMOLD_FRONTEND_IMAGE=cloudmold/admin-web:replace-with-commit-sha
